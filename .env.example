# TZStudies Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Flask
FLASK_ENV=development
# Generate this value with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PUBLIC_BASE_URL=https://mytzstudies.com
ANALYTICS_ENABLED=true
# Add any deployment hostname, comma-separated; Render's hostname is detected automatically.
TRUSTED_HOSTS=mytzstudies.com,www.mytzstudies.com
# Set to the exact number of trusted reverse proxies. Render's edge normally uses 1.
# The origin must be reachable only through those proxies when this is nonzero.
TRUSTED_PROXY_HOPS=0

# Database (PostgreSQL)
# For local development: postgresql://user:pass@localhost:5432/tzstudies
# For Render: provided automatically
DATABASE_URL=sqlite:///tzstudies.db

# OpenAI (for AI Study Assistant)
OPENAI_API_KEY=sk-your-key-here

# Email (Gmail SMTP — requires App Password)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Redis is REQUIRED in production for rate limits shared across workers.
# Use the provider's private Redis network or certificate-verified rediss:// connection.
# REDIS_URL=redis://localhost:6379/0
